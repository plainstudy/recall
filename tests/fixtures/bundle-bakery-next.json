          "cards": [
            {
              "cardId": "pa_l02_c01",
              "type": "teach",
              "prompt": "A tart case is often baked empty first, lined with paper and filled with dried beans to hold its shape. Bakers call this baking blind. The filling goes in afterwards, so the base stays crisp."
            },
            {
              "cardId": "pa_l02_c02",
              "type": "mcq",
              "srsKey": "atom.technique.baking-blind",
              "prompt": "Why is a tart case baked blind?",
              "options": [
                {
                  "id": "a",
                  "text": "So the base stays crisp under the filling",
                  "correct": true,
                  "feedback": "The case sets before anything wet goes in."
                },
                {
                  "id": "b",
                  "text": "So the filling cooks faster",
                  "correct": false,
                  "feedback": "The filling isn't in the case yet."
                },
                {
                  "id": "c",
                  "text": "So the dough rises higher",
                  "correct": false,
                  "feedback": "The beans are there to stop it rising."
                }
              ],
              "feedback": "Baking blind is about the base.",
              "difficulty": 1,
              "glossaryRefs": []
            },
            {
              "cardId": "pa_l02_c03",
              "type": "multi",
              "srsKey": "atom.pastry.layered-kinds",
              "prompt": "Which of these are layered with butter? Choose every one that is.",
              "options": [
                {
                  "id": "a",
                  "text": "Croissant",
                  "correct": true
                },
                {
                  "id": "b",
                  "text": "Puff pastry",
                  "correct": true
                },
                {
                  "id": "c",
                  "text": "Shortcrust",
                  "correct": false
                },
                {
                  "id": "d",
                  "text": "Sponge",
                  "correct": false
                }
              ],
              "feedback": "Croissant and puff pastry are both folded with butter. Shortcrust is rubbed together, and a sponge is a batter.",
              "difficulty": 2,
              "glossaryRefs": [
                "lamination"
              ]
            },
            {
              "cardId": "pa_l02_c04",
              "type": "teach",
              "prompt": "Before baking, pastry is brushed with beaten egg. It gives the shine and the deep colour. Brush the tops only: egg that runs down the cut sides glues the layers shut."
            },
            {
              "cardId": "pa_l02_c05",
              "type": "cloze",
              "srsKey": "atom.technique.egg-wash",
              "prompt": "Egg on the cut sides of layered pastry ___ the layers.",
              "chips": [
                {
                  "id": "a",
                  "text": "glues",
                  "correct": true
                },
                {
                  "id": "b",
                  "text": "lifts",
                  "correct": false
                },
                {
                  "id": "c",
                  "text": "doubles",
                  "correct": false
                }
              ],
              "feedback": "Keep the egg on the tops, and the sides are free to rise.",
              "difficulty": 1,
              "glossaryRefs": [
                "lamination"
              ]
            },
            {
              "cardId": "pa_l02_c06",
