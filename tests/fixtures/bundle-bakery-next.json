      "lessons": [
        {
          "lessonId": "bk_l01",
          "order": 1,
          "title": "Starting a dough",
          "objective": "Say what raises a dough, and read a simple order.",
          "estMinutes": 6,
          "prerequisites": [],
          "verification": {
            "status": "verified",
            "sources": [
              "Invented for tests."
            ],
            "checkedOn": "2026-11-08",
            "note": "Invented content."
          },
          "cards": [
            {
              "cardId": "bk_l01_c01",
              "type": "teach",
              "prompt": "A dough needs flour, water, salt and something to raise it. A `levain` is a culture of flour and water that a baker keeps and feeds for weeks; a poolish is mixed once, the night before, with a little yeast. Either one makes a loaf taste of more than flour.",
              "figure": "fig_loaf_section"
            },
            {
              "cardId": "bk_l01_c02",
              "type": "mcq",
              "srsKey": "atom.ingredient.levain",
              "prompt": "Which of these is kept and fed for weeks?",
              "options": [
                {
                  "id": "a",
                  "text": "Levain",
                  "correct": true,
                  "termRef": "levain",
                  "feedback": "A levain is fed again and again, so it lasts."
                },
                {
                  "id": "b",
                  "text": "Poolish",
                  "correct": false,
                  "termRef": "poolish",
                  "feedback": "A poolish is mixed once, for one bake, and used up."
                },
                {
                  "id": "c",
                  "text": "Brine",
                  "correct": false,
                  "feedback": "Brine is salted water; it raises nothing."
                }
              ],
              "feedback": "A kept culture is what makes a levain a levain.",
              "difficulty": 1,
              "glossaryRefs": [
                "levain"
              ],
              "authorNote": "An unknown field, kept as read."
            },
            {
              "cardId": "bk_l01_c03",
              "type": "teach",
              "prompt": "Shaping a round loaf takes three moves. Fold the edges into the middle. Turn the dough over, seam down. Then pull it across the bench towards you, so the surface tightens.",
              "figure": "fig_shaping_steps"
            },
            {
              "cardId": "bk_l01_c04",
              "type": "cloze",
              "srsKey": "atom.ingredient.hydration",
              "prompt": "A culture fed `1:1` flour to water by weight is at ___ hydration.",
              "chips": [
                {
                  "id": "a",
                  "text": "100%",
                  "correct": true
                },
                {
                  "id": "b",
                  "text": "50%",
                  "correct": false
                },
                {
                  "id": "c",
                  "text": "75%",
                  "correct": false
                }
              ],
              "feedback": "Hydration is water over flour: equal weights make 100%.",
              "difficulty": 1,
              "glossaryRefs": [
                "levain"
              ]
            },
            {
              "cardId": "bk_l01_c05",
              "type": "match",
              "srsKey": "atom.ingredient.pre-ferments",
              "prompt": "Match each word to what it names.",
              "pairs": [
                {
                  "id": "lv",
                  "left": "Levain",
                  "right": "A culture kept for weeks"
                },
                {
                  "id": "pl",
                  "left": "Poolish",
                  "right": "A pre-ferment mixed once"
                },
                {
                  "id": "bn",
                  "left": "Banneton",
                  "right": "A basket for the rise"
                }
              ],
              "feedback": "Two ways to raise a dough, and one tool to hold it while it rises.",
              "difficulty": 1,
              "glossaryRefs": [
                "levain",
                "poolish",
                "banneton"
              ]
            },
            {
              "cardId": "bk_l01_c06",
              "type": "multi",
              "srsKey": "atom.ingredient.raising-agents",
              "prompt": "Which of these can raise a dough? Choose every one that can.",
              "options": [
                {
                  "id": "a",
                  "text": "Levain",
                  "correct": true,
                  "termRef": "levain"
                },
                {
                  "id": "b",
                  "text": "Packet yeast",
                  "correct": true
                },
                {
                  "id": "c",
                  "text": "Poolish",
                  "correct": true,
                  "termRef": "poolish"
                },
                {
                  "id": "d",
                  "text": "Salt",
                  "correct": false
                },
                {
                  "id": "e",
                  "text": "Rye flour",
                  "correct": false
                }
              ],
              "feedback": "Levain, yeast and poolish all carry live yeast. Salt slows it down; rye flour feeds it but raises nothing on its own.",
              "difficulty": 2,
              "glossaryRefs": [
                "levain",
                "poolish"
              ]
            },
            {
              "cardId": "bk_l01_c09",
              "type": "order",
              "srsKey": "atom.technique.loaf-steps",
              "prompt": "Put the steps of a simple loaf in order.",
              "items": [
                {
                  "id": "shape",
                  "text": "Shape",
                  "position": 3
                },
                {
                  "id": "mix",
                  "text": "Mix",
                  "position": 1
                },
                {
                  "id": "bake",
                  "text": "Bake",
                  "position": 4
                },
                {
                  "id": "rest",
                  "text": "Rest",
                  "position": 2
                }
              ],
              "feedback": "Mix, rest, shape, bake: the dough needs its rest before it can hold a shape.",
              "difficulty": 1,
              "glossaryRefs": []
            },
            {
              "cardId": "bk_l01_c07",
              "type": "mcq",
              "srsKey": "atom.technique.timing",
              "prompt": "A bakery mixes its dough at six in the evening and wants loaves on the shelf by seven the next morning. The kitchen is cool overnight, the levain was fed at noon, and the oven takes forty minutes to heat. Which plan gets the loaves out on time without rushing the rise or leaving the dough to over-prove before it goes in?",
              "options": [
                {
                  "id": "a",
                  "text": "Shape at five, prove the loaves in the cool kitchen until six, and heat the oven from twenty past five",
                  "correct": true,
                  "feedback": "The rise gets its hour, and the oven is hot when the loaves are ready."
                },
                {
                  "id": "b",
                  "text": "Shape at midnight and leave the loaves out on the bench all night, then bake them first thing at six",
                  "correct": false,
                  "feedback": "Six hours on the bench is far too long; the loaves collapse before they bake."
                },
                {
                  "id": "c",
                  "text": "Mix again at four in the morning with extra packet yeast, then shape, prove and bake in one hurried run",
                  "correct": false,
                  "feedback": "Starting again throws away the overnight flavour and rushes every step."
                },
                {
                  "id": "d",
                  "text": "Bake the dough unshaped at six in the evening and slice the loaves for the shelf on the following morning",
                  "correct": false,
                  "feedback": "Unshaped, unrisen dough bakes into a flat, dense slab."
                }
              ],
              "feedback": "Work back from the shelf time: bake, then prove, then shape, with the oven started early enough to be hot.",
              "difficulty": 3,
              "glossaryRefs": [
                "levain"
              ]
            },
            {
              "cardId": "bk_l01_c10",
              "type": "mcq",
              "srsKey": "atom.ingredient.salt",
              "prompt": "Which of these slows a levain down when it goes into the dough?",
              "options": [
                {
                  "id": "a",
                  "text": "Salt",
                  "correct": true,
                  "feedback": "Salt tightens the dough and slows the culture."
                },
                {
                  "id": "b",
                  "text": "Warm water",
                  "correct": false,
                  "feedback": "Warmth speeds a levain up."
                },
                {
                  "id": "c",
                  "text": "A spoon of honey",
                  "correct": false,
                  "feedback": "Sugar feeds the culture."
                }
              ],
              "feedback": "Bakers add salt after the first mix for this reason.",
              "difficulty": 1,
              "glossaryRefs": [
                "levain"
              ]
            },
            {
              "cardId": "bk_l01_c08",
              "type": "desk",
              "srsKey": "atom.desk.order-note",
              "deskRef": true,
              "prompt": "A customer leaves this note at the counter. What do they want?",
              "artifact": {
                "kind": "enquiry",
                "text": "2 x round sourdough\nSat, ready by 08:00\nsliced pls, no seeds"
              },
              "options": [
                {
                  "id": "a",
                  "text": "Two round sourdough loaves, sliced, without seeds, by eight on Saturday",
                  "correct": true,
                  "feedback": "Everything the note asks for, read in full."
                },
                {
                  "id": "b",
                  "text": "Two seeded round loaves, left whole, ready on Saturday morning",
                  "correct": false,
                  "feedback": "The note says no seeds, and asks for the loaves sliced."
                },
                {
                  "id": "c",
                  "text": "Round sourdough for two people, with seeds, on Saturday",
                  "correct": false,
                  "feedback": "\"2 x\" counts loaves, not people, and the note rules out seeds."
                }
              ],
              "difficulty": 2,
              "glossaryRefs": []
            }
          ]
        },
        {
          "lessonId": "bk_l02",
          "order": 2,
          "title": "At the oven",
          "objective": "Read the signs of a good bake, and name the tools around the oven.",
          "estMinutes": 6,
          "prerequisites": [
            "bk_l01"
          ],
          "verification": {
