                {
                  "id": "c",
                  "text": "Six almond croissants in one box, by seven on Friday",
                  "correct": false,
                  "feedback": "That leaves out the six plain ones."
                }
              ],
              "difficulty": 2,
              "glossaryRefs": []
            }
          ]
