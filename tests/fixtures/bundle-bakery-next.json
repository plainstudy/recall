        {
          "lessonId": "pa_l02",
          "order": 2,
          "title": "From the tin to the counter",
          "objective": "Name the common pastries, and read a note left for the next shift.",
          "estMinutes": 4,
          "prerequisites": [
            "pa_l01"
          ],
          "verification": {
            "status": "verified",
