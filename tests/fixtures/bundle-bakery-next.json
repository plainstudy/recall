          "lessonId": "pa_l01",
          "order": 1,
          "title": "Layers of butter",
          "objective": "Say how layered pastry gets its layers, and read a pastry order.",
          "estMinutes": 4,
          "prerequisites": [],
          "verification": {
            "status": "verified",
            "sources": [
              "Invented for tests."
            ],
            "checkedOn": "2026-11-10",
            "note": "Invented content."
          },
          "cards": [
            {
              "cardId": "pa_l01_c01",
              "type": "teach",
              "prompt": "Layered pastry starts as a slab of butter wrapped in dough. Rolling it out and folding it, again and again, is `lamination`: each fold multiplies the layers. In the oven the water in the butter turns to steam and lifts them apart."
            },
            {
              "cardId": "pa_l01_c02",
              "type": "mcq",
              "srsKey": "atom.technique.lamination",
              "prompt": "What gives a croissant its layers?",
              "options": [
                {
                  "id": "a",
                  "text": "Lamination",
                  "correct": true,
                  "termRef": "lamination",
                  "feedback": "Folding butter into the dough, again and again, makes the layers."
                },
                {
                  "id": "b",
                  "text": "Scoring",
                  "correct": false,
                  "termRef": "scoring",
                  "feedback": "Scoring is the cut on a loaf before it bakes."
                },
                {
                  "id": "c",
                  "text": "A long knead",
                  "correct": false,
                  "feedback": "Kneading builds stretch, and it would work the butter into the dough."
                }
              ],
              "feedback": "Layers come from folds, with butter between them.",
              "difficulty": 1,
              "glossaryRefs": [
                "lamination"
              ]
            },
            {
              "cardId": "pa_l01_c03",
              "type": "teach",
              "prompt": "The butter has to stay cold and firm. Warm butter soaks into the dough, and the layers are gone before the oven. So the dough goes back to the fridge between folds."
            },
            {
              "cardId": "pa_l01_c04",
              "type": "cloze",
              "srsKey": "atom.technique.cold-butter",
              "prompt": "Between folds the dough rests in the fridge, so the butter stays ___.",
              "chips": [
                {
                  "id": "a",
                  "text": "cold",
                  "correct": true
                },
                {
                  "id": "b",
                  "text": "soft",
                  "correct": false
                },
                {
                  "id": "c",
                  "text": "melted",
                  "correct": false
                }
              ],
              "feedback": "Cold butter stays in its own layer.",
              "difficulty": 1,
              "glossaryRefs": [
                "lamination"
              ]
            },
            {
              "cardId": "pa_l01_c05",
              "type": "cloze",
              "srsKey": "atom.ingredient.hydration",
              "prompt": "A pastry dough of `1000 g` flour and `600 g` water is at ___ hydration.",
              "chips": [
                {
                  "id": "a",
                  "text": "60%",
                  "correct": true
                },
                {
                  "id": "b",
                  "text": "40%",
                  "correct": false
                },
                {
                  "id": "c",
                  "text": "160%",
                  "correct": false
                }
              ],
              "feedback": "Hydration is water over flour, here as in bread: 600 over 1000.",
              "difficulty": 2,
              "glossaryRefs": []
            },
            {
              "cardId": "pa_l01_c06",
              "type": "order",
              "srsKey": "atom.technique.fold-steps",
              "prompt": "Put one round of folding in order.",
              "items": [
                {
                  "id": "chill",
                  "text": "Chill",
                  "position": 3
                },
                {
                  "id": "roll",
                  "text": "Roll out",
                  "position": 1
                },
                {
                  "id": "fold",
                  "text": "Fold in three",
                  "position": 2
                }
              ],
              "feedback": "Roll, fold, chill: then the next round starts.",
              "difficulty": 1,
              "glossaryRefs": [
                "lamination"
              ]
            },
            {
              "cardId": "pa_l01_c07",
              "type": "desk",
              "srsKey": "atom.desk.pastry-order",
              "deskRef": true,
              "prompt": "This order comes in by text. What has to be ready?",
              "artifact": {
                "kind": "enquiry",
                "text": "12 x croissant for Fri 07:00\n6 plain, 6 almond\nboxed in sixes"
              },
              "options": [
                {
                  "id": "a",
                  "text": "Six plain and six almond croissants, in two boxes of six, by seven on Friday",
                  "correct": true,
                  "feedback": "Twelve in all, split by kind, and boxed as asked."
                },
                {
                  "id": "b",
                  "text": "Twelve plain and twelve almond croissants, loose, on Friday morning",
                  "correct": false,
                  "feedback": "The twelve is the total, and the order asks for boxes."
