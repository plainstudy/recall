          "cards": [
            {
              "cardId": "bk_l02_c01",
              "type": "teach",
              "prompt": "`Oven spring` is the last rise a loaf makes in the first minutes of baking, before the crust sets. A deep score gives that rise somewhere to go: the cut opens and lifts into a flap called the ear.",
              "figure": "fig_not_in_pack"
            },
            {
              "cardId": "bk_l02_c02",
              "type": "hotspot",
              "srsKey": "atom.technique.scoring-ear",
              "prompt": "Tap the ear: the flap a good score lifts as the loaf springs.",
              "figure": "fig_loaf_section",
              "regions": [
                {
                  "id": "ear",
                  "label": "The ear",
                  "shape": {
                    "polygon": [
                      140,
                      40,
                      240,
                      40,
                      245,
                      110,
                      160,
                      130
                    ]
                  },
                  "correct": true,
                  "feedback": "The ear is the edge of the cut, lifted by oven spring."
                },
                {
                  "id": "pocket",
                  "label": "A large air pocket",
                  "shape": {
                    "circle": [
                      100,
                      230,
                      32
                    ]
                  },
                  "correct": false,
                  "feedback": "A large pocket is trapped gas, often from loose shaping."
                },
                {
                  "id": "crumb",
                  "label": "The crumb",
                  "shape": {
                    "rect": [
                      160,
                      180,
                      80,
                      90
                    ]
                  },
                  "correct": false,
                  "feedback": "The crumb is the inside; the ear is on the crust."
                },
                {
                  "id": "base",
                  "label": "The base",
                  "shape": {
                    "rect": [
                      30,
                      316,
                      240,
                      54
                    ]
                  },
                  "correct": false,
                  "feedback": "The base sat on the oven floor; nothing lifts there."
                }
              ],
              "feedback": "A clean, lifted ear shows the score was deep enough and the loaf still had spring in it.",
              "difficulty": 2,
              "glossaryRefs": [
                "scoring",
                "oven-spring"
              ]
            },
            {
              "cardId": "bk_l02_c03",
              "type": "match",
              "srsKey": "atom.tool.bench-tools",
              "prompt": "Match each tool to its job.",
              "pairs": [
                {
                  "left": "Lame",
                  "right": "Cuts the score"
                },
                {
                  "left": "Couche",
                  "right": "Holds long loaves"
                },
                {
                  "left": "Peel",
                  "right": "Slides loaves into the oven"
                },
                {
                  "left": "Bench scraper",
                  "right": "Divides the dough"
                }
              ],
              "feedback": "Four tools, four jobs, from the bench to the oven.",
              "difficulty": 2,
              "glossaryRefs": [
                "couche"
              ]
            },
            {
              "cardId": "bk_l02_c04",
              "type": "mcq",
              "srsKey": "atom.ingredient.poolish",
              "prompt": "The recipe says to make a poolish tonight. What do you mix?",
              "options": [
                {
                  "id": "a",
                  "text": "Flour, water and a little packet yeast",
                  "correct": true,
                  "termRef": "poolish",
                  "feedback": "That is a poolish: mixed once, used in the morning."
                },
                {
                  "id": "b",
                  "text": "A spoonful of the kept levain, fed again",
                  "correct": false,
                  "termRef": "levain",
                  "feedback": "That feeds a levain; it doesn't make a poolish."
                },
                {
                  "id": "c",
                  "text": "Flour and water alone, left for a week",
                  "correct": false,
                  "termRef": "levain",
                  "feedback": "That starts a new culture, which takes days."
                }
              ],
              "feedback": "Poolish: one night, a little yeast.",
              "trap": true,
              "trapFeedback": "A poolish and a levain both raise dough, but one is mixed for a single bake and the other is kept. Swapping them changes the timing of the whole bake.",
              "difficulty": 2,
              "glossaryRefs": [
                "poolish",
                "levain"
              ]
            },
            {
              "cardId": "bk_l02_c05",
              "type": "variant",
              "srsKey": "atom.tool.banneton",
